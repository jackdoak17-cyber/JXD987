# Required API keys
SPORTMONKS_API_TOKEN=replace-me
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3
ODDS_API_KEY=replace-me
ODDS_API_BASE=https://api2.odds-api.io/v3

# Supabase (required for export/maintenance scripts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_URL_SESSION=
SUPABASE_DB_URL_POOLER=

# Local data
DATABASE_URL=sqlite:///data/jxd.sqlite

# Defaults / tuning
REQUESTS_PER_HOUR=3500
BOOKMAKER_ID=2
ODDS_BOOKMAKERS=Bet365,Paddy Power,Unibet,BetMGM
LEAGUE_IDS=8,9,72,82,181,208,244,271,301,384,387,444,453,462,501,564,567,573,591,600
USE_FILTERS_POPULATE=true
LOG_LEVEL=INFO

# Optional odds sync tuning
ODDS_MARKET_ALLOWLIST=
ODDS_API_RETRIES=3
ODDS_API_SLEEP_BASE=1
ODDS_API_SLEEP_MAX=10
ODDS_API_RATE_LIMIT_PER_HOUR=5000
ODDS_LOCK_TIMEOUT=0
ODDS_STATEMENT_TIMEOUT=0
ODDS_ADVISORY_LOCK_KEY=982374
ODDS_IDLE_TX_TIMEOUT=0
ODDS_USE_ADVISORY_LOCK=false
ODDS_SYNC_REPORT_PATH=
ODDS_SYNC_MAX_CONCURRENT=3

# VPS scheduler/lock tuning
ODDS_SYNC_LOCK_FILE=/var/lock/odds-sync.lock
ODDS_SYNC_P3_MAX_DURATION_SECONDS=600
HEALTHCHECK_PING_URL=
HEALTHCHECK_PING_URL_P1=
HEALTHCHECK_PING_URL_P2=
HEALTHCHECK_PING_URL_P3=
ODDS_DAYS_FORWARD=14
ODDS_INGEST_MAX_RUNTIME_MINUTES=25
RETENTION_DAYS_BACK=1
RETENTION_DAYS_FORWARD=14
RETENTION_SNAPSHOT_DAYS=30

# Optional Supabase export tuning
SUPABASE_EXPORT_CHUNK=50
SUPABASE_EXPORT_SLEEP=0.5
SUPABASE_EXPORT_RETRIES=3
